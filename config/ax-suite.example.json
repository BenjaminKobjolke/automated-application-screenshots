{
  "output_dir": "../screenshots/ax-suite",
  "web": {
    "base_url": "https://localhost/ax-suite-contest",
    "login_header": {
      "name": "X-Agent-Login",
      "value": "PASTE-VIEWER-API-KEY-HERE"
    },
    "viewport": {"width": 1280, "height": 800},
    "headless": true,
    "channel": "msedge",
    "ignore_https_errors": true,
    "languages": ["de"],
    "pages": [
      {"name": "login", "path": "/admin/login"},
      {"name": "overview", "path": "/admin/overview"},
      {"name": "contest-editor-common", "path": "/admin/contest/newedit/common/<CONTEST-ID>"},
      {"name": "contest-editor-design", "path": "/admin/contest/newedit/design/<CONTEST-ID>"},
      {"name": "contest-statistics", "path": "/admin/contests/<CONTEST-ID>/statistics"}
    ]
  },
  "demos": [
    {
      "id": 1,
      "name": "overview",
      "path": "/admin/overview",
      "formats": ["gif", "mp4"],
      "fps": 10
    },
    {
      "id": 2,
      "name": "contest-walkthrough",
      "path": "/contests/<CONTEST-ID>/",
      "formats": ["gif", "mp4"],
      "fps": 10
    },
    {
      "id": 3,
      "name": "contest-editor",
      "path": "/admin/contest/newedit/common/<CONTEST-ID>",
      "formats": ["gif", "mp4"],
      "fps": 10
    }
  ]
}
